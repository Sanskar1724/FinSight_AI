# Copy to backend/.env and adjust for your environment.
# Values below are development defaults. Never use the example secret in production.

APP_NAME=FinSight AI
ENVIRONMENT=development
API_PREFIX=/api

# SQLite is the zero-setup default. Relative SQLite paths resolve from the working directory.
# DATABASE_URL=sqlite:///./data/finsight.db
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://finsight:change-me@localhost:5432/finsight

SECRET_KEY=replace-with-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=10080
COOKIE_NAME=finsight_session
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTH_RATE_LIMIT_ATTEMPTS=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=300

# Public URL of the web app, used for links in emails.
PUBLIC_APP_URL=http://localhost:5173
# Contact shown on the Privacy Policy and Terms for data requests. When empty,
# the pages link to the GitHub repository's Issues page instead.
SUPPORT_EMAIL=

# Outgoing email for password resets. Leave SMTP_HOST empty in development to
# print emails to the log instead. Any SMTP provider works, e.g. Brevo:
# SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587  SMTP_USER=<login>  SMTP_PASSWORD=<smtp key>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
MAIL_FROM=FinSight AI <no-reply@finsight.local>
PASSWORD_RESET_MINUTES=30

DEMO_EMAIL=demo@finsight.local
DEMO_PASSWORD=Demo@12345
DEMO_NAME=Aarav Mehta
TIMEZONE=Asia/Kolkata

AUTO_CREATE_TABLES=true
SEED_DEMO_ON_STARTUP=true
ENABLE_SCHEDULER=true
NOTIFICATION_CHECK_MINUTES=30

# Deterministic mode needs no API key. To use an OpenAI-compatible provider,
# set AI_PROVIDER and AI_API_KEY. AI_BASE_URL should include /v1.
AI_PROVIDER=deterministic
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=30
AI_MAX_CONTEXT_CHARS=6000
AI_RATE_LIMIT_PER_HOUR=40

RESEARCH_MAX_CASES=60
PROMPT_VERSION=chat-v1
RESEARCH_PROMPT_VERSION=research-v1
