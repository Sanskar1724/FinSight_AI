# Keep the build context small and free of local data and secrets.
.git
.github
.claude
.gitignore
.dockerignore
docs
*.md

**/.env
**/.env.*
!**/.env.example

**/node_modules
frontend/dist
frontend/.vite
frontend/*.tsbuildinfo

**/.venv
**/__pycache__
**/*.py[cod]
backend/.pytest_cache
backend/htmlcov
backend/.coverage
backend/tests
backend/data/*.db
backend/data/*.db-journal
